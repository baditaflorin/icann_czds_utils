# ICANN CZDS API Configuration
CZDS_USERNAME=your_username_here
CZDS_PASSWORD=your_password_here
CZDS_API_BASE_URL=https://czds-api.icann.org

# Database Configuration
DATABASE_PATH=./data/czds.db
DATABASE_TIMEOUT=30

# Application Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/czds_utils.log
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Zone File Processing
ZONE_FILES_DIR=./zone_files
MAX_FILE_SIZE_MB=5000
CHUNK_SIZE=8192

# Security
VALIDATE_SSL=true
MAX_INPUT_LENGTH=1000

# GUI Configuration
GUI_THEME=default
WINDOW_WIDTH=1000
WINDOW_HEIGHT=700
